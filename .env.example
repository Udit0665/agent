# Copy to .env  (cp .env.example .env) and fill in. Never share this file.
CHARIOT_API_KEY=
# CHARIOT_VOICE_ID=dc5f3eed-6a2a-4257-aa6f-b4be6d4c7b63   # "ananya" (female)

# STT_BACKEND=auto        # auto | chariot | android   (auto = chariot if key is set)
WAKE_WORDS=jarvis,jarvish,jarwis,jarves,jervis,travis
WAKE_WORD_REQUIRED=true   # false = react to everything you say (not recommended)
SESSION_SECS=25           # after the wake word, follow-ups work without it for this long
CONFIRM_VOICE_CALLS=true  # voice calls/SMS ask "say yes to confirm"
# SPEECH_DB=-38           # raise (e.g. -32) if it reacts to noise, lower if it misses you
# CHUNK_SECS=3
GREET=true
AUTOSTART_LISTEN=true
